{
  "manifest_version": 3,
  "name": "RewindSweep - YouTube History Cleaner",
  "version": "1.1.2",
  "description": "Find and delete videos matching specific keywords from your YouTube watch history and Chrome history.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RewindSweep"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "history",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ]
}
